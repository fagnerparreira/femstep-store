# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=femstep_store
DB_USERNAME=postgres
# Required. Generate a unique high-entropy password.
DB_PASSWORD=

# JWT Configuration
# Required. Generate at least 32 random bytes; do not reuse another password.
JWT_SECRET=
JWT_EXPIRATION=900000
# Para HTTP local use false; em produção com HTTPS use true.
COOKIE_SECURE=false
# Ambiente demonstrativo. Em produção mantenha false e configure um gateway real.
PAYMENTS_SANDBOX_ENABLED=true
RATE_LIMIT_ENABLED=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Backend Configuration
BACKEND_PORT=8080
BACKEND_HOST=localhost
SPRING_PROFILES_ACTIVE=prod
SPRINGDOC_ENABLED=false

# Frontend Configuration
FRONTEND_PORT=4200
FRONTEND_HOST=localhost
API_BASE_URL=http://localhost:8080/api

# Docker Configuration
POSTGRES_IMAGE=postgres:15
POSTGRES_CONTAINER_NAME=femstep-postgres
BACKEND_CONTAINER_NAME=femstep-backend
FRONTEND_CONTAINER_NAME=femstep-frontend

# Email Configuration
# Docker local usa Mailpit; abra http://localhost:8025.
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_POLL_INTERVAL_MS=5000
MAILPIT_UI_PORT=8025
MAILPIT_CONTAINER_NAME=femstep-mailpit
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SMTP_AUTH=false
EMAIL_STARTTLS_ENABLED=false
EMAIL_STARTTLS_REQUIRED=false
EMAIL_FROM=nao-responda@movazu.local
PUBLIC_APP_URL=http://localhost:4200

# File Upload Configuration
MAX_FILE_SIZE=10MB
UPLOAD_PATH=./uploads

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
