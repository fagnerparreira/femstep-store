# Copie os nomes para o secret manager da hospedagem. Não publique este arquivo
# preenchido e não reutilize valores de local ou produção.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=staging-postgres.internal
DB_PORT=5432
DB_NAME=femstep_staging
DB_USERNAME=femstep_staging
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION=900000
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://staging.seudominio.com.br
PUBLIC_APP_URL=https://staging.seudominio.com.br
PAYMENTS_SANDBOX_ENABLED=true
RATE_LIMIT_ENABLED=true
SPRINGDOC_ENABLED=false

ADMIN_EMAIL=
ADMIN_PASSWORD=

NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_POLL_INTERVAL_MS=5000
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SMTP_AUTH=true
EMAIL_STARTTLS_ENABLED=true
EMAIL_STARTTLS_REQUIRED=true
EMAIL_FROM=

# Defina somente quando os adaptadores reais forem implementados.
PAYMENT_PROVIDER_TOKEN=
PAYMENT_WEBHOOK_SECRET=
SHIPPING_PROVIDER_TOKEN=
SHIPPING_ORIGIN_POSTAL_CODE=
